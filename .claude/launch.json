{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "eco-oil-miniapp",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PATH=/home/ADMIN/.local/share/pnpm/bin:/home/ADMIN/.local/bin:/usr/local/bin:/usr/bin:/bin",
        "pnpm",
        "--filter",
        "@eco-oil/miniapp",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "eco-oil-miniapp-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PATH=/home/ADMIN/.local/share/pnpm/bin:/home/ADMIN/.local/bin:/usr/local/bin:/usr/bin:/bin",
        "VITE_DEMO_MODE=true",
        "VITE_DEMO_OFFLINE=true",
        "pnpm",
        "--filter",
        "@eco-oil/miniapp",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "eco-oil-admin",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PATH=/home/ADMIN/.local/share/pnpm/bin:/home/ADMIN/.local/bin:/usr/local/bin:/usr/bin:/bin",
        "pnpm",
        "--filter",
        "@eco-oil/admin",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "eco-oil-admin-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PATH=/home/ADMIN/.local/share/pnpm/bin:/home/ADMIN/.local/bin:/usr/local/bin:/usr/bin:/bin",
        "NEXT_PUBLIC_DEMO_OFFLINE=1",
        "NEXT_PUBLIC_LOGIN_GATE_URL=http://localhost:5173",
        "pnpm",
        "--filter",
        "@eco-oil/admin",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "eco-oil-miniapp-zmp-preview",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PATH=/home/ADMIN/.local/share/pnpm/bin:/home/ADMIN/.local/bin:/usr/local/bin:/usr/bin:/bin",
        "pnpm",
        "--filter",
        "@eco-oil/miniapp",
        "exec",
        "vite",
        "preview",
        "--outDir",
        "dist",
        "--port",
        "4173"
      ],
      "port": 4173
